APP_NAME="MyAthens Transfers"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Europe/Athens

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# A LOCAL COPY of the MyAT database (never point a dev machine at production).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kwi14599_myat
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail: the same mailbox as PHPRunner (mail.touro.gr, SSL on 465, sent as myat@touro.gr).
# Keep MAIL_MAILER=log on test copies (mails go to storage/logs); set smtp on the live app,
# with the mailbox password here only, never in git.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=mail.touro.gr
MAIL_PORT=465
MAIL_USERNAME=myat@touro.gr
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="myat@touro.gr"
MAIL_FROM_NAME="MyAthensTransfers"
# Test copies: every e-mail goes only to this address (Cc/Bcc dropped), with a yellow strip
# showing who it would have gone to. Leave empty on the live app.
MAIL_ALWAYS_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Integrations (filled in as modules are ported; never commit real values)
# Elorus invoicing. Off by default so a copy of the database never issues real
# invoices. Turn on only where documents should really be created (the live app).
# Token/organisation default to the elorus_Settings table that PHPRunner uses.
ELORUS_ENABLED=false
ELORUS_API_TOKEN=
ELORUS_ORGANIZATION_ID=
# Telegram to drivers: off unless TELEGRAM_ENABLED=true (keep it off on test copies).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Folder of the PHPRunner app on the same server (with its files/ folder), e.g.
# /home/kwi14599/myat.touro.gr. Lets driver files / fuel receipts be uploaded.
PHPRUNNER_URL=https://myat.touro.gr
PHPRUNNER_ROOT=

# Server only: the token GitHub Actions uses to unpack a new version (public/deploy.php).
DEPLOY_TOKEN=
