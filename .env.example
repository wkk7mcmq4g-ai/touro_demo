APP_NAME="Demo Transfers"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Test site: https://new.demo.touro.gr

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Europe/Athens

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The Demo showcase runs on an ANONYMISED COPY of the MyAT database
# (database/legacy/demo/anonymise.sql). Never point it at a live database.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kwi14599_demo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail: the same mailbox as PHPRunner (mail.touro.gr, SSL on 465, sent as myat@touro.gr).
# The Demo keeps MAIL_MAILER=log ALWAYS (its data is invented; nothing should be sent).
# Keep MAIL_MAILER=log on test copies (mails go to storage/logs); set smtp on the live app,
# with the mailbox password here only, never in git.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=mail.touro.gr
MAIL_PORT=465
MAIL_USERNAME=myat@touro.gr
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="myat@touro.gr"
MAIL_FROM_NAME="Demo Transfers"
# Test copies: every e-mail goes only to this address (Cc/Bcc dropped), with a yellow strip
# showing who it would have gone to. Leave empty on the live app.
MAIL_ALWAYS_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The business (config/business.php has the full list with comments, plus the colours,
# logo files and voucher images). These are the Demo's values; config/business.php
# already has them, so the server's .env needs none of these lines.
BUSINESS_NAME="Demo Transfers"
BUSINESS_SHORT_NAME=Demo
BUSINESS_TRADE_NAME="Demo Transfers & Tours"
BUSINESS_LEGAL_NAME="Demo Transfers IKE"
BUSINESS_MHTE=0000E00000000000
BUSINESS_WEBSITE=www.example.com
BUSINESS_EMAIL=info@example.com
BUSINESS_RESERVATIONS_EMAIL=rsv@example.com
BUSINESS_OPS_NAME=
BUSINESS_OPS_TITLE="Operations Desk"
BUSINESS_OPS_EMAIL=ops@example.com
BUSINESS_OPS_PHONE="+30 210 000 0000"
BUSINESS_TAGLINE="Transfers & Tours"
BUSINESS_WORDMARK_PREFIX=
BUSINESS_WORDMARK_MAIN=Demo
BUSINESS_WORDMARK_SUFFIX=" Transfers"
BUSINESS_MAIL_LOGO_URL=https://touro.gr/images/Touro_email.jpg
BUSINESS_COLOR_PRIMARY="#6366f1"
BUSINESS_COLOR_NAVY="#1e1b4b"
BUSINESS_COLOR_ACCENT="#22d3ee"
# Daily dispatch overrides (empty: the operations desk / general mailbox above).
DISPATCH_REPLY_TO=
DISPATCH_OLP_BCC=

# Integrations (filled in as modules are ported; never commit real values)
# Elorus invoicing. Off by default so a copy of the database never issues real
# invoices. Turn on only where documents should really be created (the live app).
# Token/organisation default to the elorus_Settings table that PHPRunner uses.
ELORUS_ENABLED=false
# Demo: Elorus buttons and screens hidden; true shows them (still need ELORUS_ENABLED to send).
ELORUS_BUTTONS=false
# Demo: the "Εισερχόμενο έμβασμα" button on Transfers is hidden; true shows it.
TRANSFERS_INCOMING_PAYMENT=false
ELORUS_API_TOKEN=
ELORUS_ORGANIZATION_ID=
# Telegram to drivers: off unless TELEGRAM_ENABLED=true (keep it off on test copies).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Demo: leave PHPRUNNER_URL and PHPRUNNER_ROOT EMPTY (there is no PHPRunner app for the
# Demo; MyAT's address would open its live app and real files).
# Folder of the PHPRunner app on the same server (with its files/ folder), e.g.
# /home/kwi14599/myat.touro.gr. Lets driver files / fuel receipts be uploaded.
# Address of the old PHPRunner app (links to pages not ported yet, document files).
PHPRUNNER_URL=
PHPRUNNER_ROOT=

# Server only: the token GitHub Actions uses to unpack a new version (public/deploy.php).
DEPLOY_TOKEN=
